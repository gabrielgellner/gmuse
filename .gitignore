# Rust build artifacts
/target/

# macOS
.DS_Store

# Credentials for the out-of-tree tag tools (Discogs, AcoustID). Prefer the
# macOS Keychain; this is the backstop for when a token lands here anyway.
.env
.env.*

# maturin writes the extension beside its Python source in a mixed layout, so
# it lands in the tree rather than under /target.
python/gmuse_core/*.so
